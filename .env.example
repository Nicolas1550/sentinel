DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
SESSION_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
ENABLE_DEMO_WRITES="false"
# Optional: HTTPS endpoint controlled by you. For production, allowlist its hostname.
SENTINEL_ALERT_WEBHOOK_URL=
SENTINEL_ALERT_WEBHOOK_ALLOWED_HOST=
SENTINEL_ALERT_WEBHOOK_SECRET=
